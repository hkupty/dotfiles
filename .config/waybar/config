{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar at the bottom of your screen
    "height": 25, // Waybar height
    "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad"],
    "modules-center": ["sway/window"],
    "modules-right": ["wireplumber", "network", "cpu", "memory", "battery", "bluetooth", "tray", "clock"],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}. {icon}",
        "format-icons": {
            "web": "",
            "code": "",
            "term": "",
            "work": "",
            "music": "",
            "docs": "",
            "urgent": "",
            "active": "",
            "persistent": "◒",
            "special": "◓",
            "empty": "◯",
            "default": ""
        }
    },
    "sway/scratchpad":{
      "format-icons": ["", "󰅍"]
    },
    "hyprland/submap": {
      "format": " {}",
      "max-length": 50
    },
    "hyprland/window": {
      "format": "{}",
      "max-length": 60,
      "rewrite": {
        "(.*) . Mozilla Firefox": " $1",
        "nvim (.*)": " $1",
        "Spotify": " Spotify",
        "Slack | (.*) | (.)": " $1[$2]"
      }
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% "
    },
    "memory": {
        "format": "{}% "
    },
    "bluetooth": {
        "format-on": "  "
    },
    "battery": {
        "bat": "BAT0",
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
        "format-disconnected": "Disconnected ⚠"
    },
    "wireplumber": {
        //"scroll-step": 1,
        "format": "{volume}% {icon} ",
        "format-muted": "",
        "format-icons": ["", ""],
        "on-click": "pwvucontrol"
    }
}
